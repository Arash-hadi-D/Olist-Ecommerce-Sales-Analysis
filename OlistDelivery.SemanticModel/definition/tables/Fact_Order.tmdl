table Fact_Order
	lineageTag: fb9e45de-89b6-5af2-983a-348175c8dcd0

	measure Orders = COUNTROWS('Fact_Order')
		formatString: #,0
		lineageTag: 446b0e84-149d-5375-862d-3ae7b6deb301

	measure 'Orders with Review' = CALCULATE([Orders], NOT ISBLANK('Fact_Order'[review_score]))
		formatString: #,0
		lineageTag: d0156010-1002-5383-bca1-d58f19ca44eb

	/// Correct: one row per order. Compare against Avg Review (Item-Weighted).
	measure 'Avg Review Score' = AVERAGE('Fact_Order'[review_score])
		formatString: 0.00
		lineageTag: 6d3b71aa-d99c-5e9f-be25-b286625da097

	/// Reproduces the flat-table error: repeats an order's score once per line item. Shown only to demonstrate the bias.
	measure 'Avg Review (Item-Weighted)' = DIVIDE(SUMX('Fact_OrderItem', RELATED('Fact_Order'[review_score])), COUNTROWS('Fact_OrderItem'))
		formatString: 0.00
		lineageTag: 18e0a466-aee6-5fe1-86cf-5684ae2edd63

	measure 'Review Weighting Bias' = [Avg Review (Item-Weighted)] - [Avg Review Score]
		formatString: 0.000
		lineageTag: fb53be68-b93c-574b-ae7e-a51cd5eff89d

	measure 'Late Orders' = CALCULATE([Orders], 'Fact_Order'[is_late] = 1)
		formatString: #,0
		lineageTag: 51fd5bf8-9117-5bfb-b0ad-e014c184caf3

	measure 'Late Rate %' = DIVIDE([Late Orders], [Orders])
		formatString: 0.0%
		lineageTag: 4496906b-af53-5dc3-9175-90648fcc69bb

	measure 'Avg Delivery Days' = AVERAGE('Fact_Order'[delivery_days])
		formatString: 0.0
		lineageTag: 0ffd3688-307f-518e-8d75-e8a997becabf

	measure 'Median Delivery Days' = MEDIAN('Fact_Order'[delivery_days])
		formatString: 0.0
		lineageTag: 13eafa06-cf0b-5f70-b807-5832df36b1d8

	measure 'Avg Days Late' = CALCULATE(AVERAGE('Fact_Order'[days_late]), 'Fact_Order'[is_late] = 1)
		formatString: 0.0
		lineageTag: e509b2f1-15d1-5254-bd33-8ed80b6c3f71

	measure 'Avg Review (On Time)' = CALCULATE([Avg Review Score], 'Fact_Order'[is_late] = 0)
		formatString: 0.00
		lineageTag: 1cfe6cbf-5f8a-5855-af22-8bf6398b0241

	measure 'Avg Review (Late)' = CALCULATE([Avg Review Score], 'Fact_Order'[is_late] = 1)
		formatString: 0.00
		lineageTag: c9de66a0-ffae-5bc1-b86d-5c8f7a44aa2e

	/// Stars lost when an order arrives late.
	measure 'Review Gap' = [Avg Review (On Time)] - [Avg Review (Late)]
		formatString: 0.00
		lineageTag: 9adad88e-2740-5120-ad8a-73a71a08c5a7

	measure '1-Star Orders' = CALCULATE([Orders], 'Fact_Order'[review_score_star] = 1)
		formatString: #,0
		lineageTag: 016513b5-eb74-5586-819a-df045d983c86

	measure '1-Star Rate %' = DIVIDE([1-Star Orders], [Orders with Review])
		formatString: 0.0%
		lineageTag: 86a4f1db-8de1-5b0f-aec3-b29dc2deb6a9

