	column 'Delivery Band' = SWITCH( TRUE(), 'Fact_Order'[delivery_days] <= 3, "0-3 days", 'Fact_Order'[delivery_days] <= 7, "4-7 days", 'Fact_Order'[delivery_days] <= 14, "8-14 days", 'Fact_Order'[delivery_days] <= 30, "15-30 days", "30+ days" )
		dataType: string
		lineageTag: 070db1b5-ab3b-5c8e-ad69-4f5f642d07a2
		summarizeBy: none
		sortByColumn: 'Delivery Band Sort'

		annotation SummarizationSetBy = Automatic

	column 'Delivery Band Sort' = SWITCH( TRUE(), 'Fact_Order'[delivery_days] <= 3, 1, 'Fact_Order'[delivery_days] <= 7, 2, 'Fact_Order'[delivery_days] <= 14, 3, 'Fact_Order'[delivery_days] <= 30, 4, 5 )
		dataType: int64
		isHidden
		lineageTag: b443c146-41e9-52ee-88a4-71e21dc6cb4d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

