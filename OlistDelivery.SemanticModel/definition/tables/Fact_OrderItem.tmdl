table Fact_OrderItem
	lineageTag: d1013b63-50c5-59d1-ac3a-e378da432a51

	measure Revenue = SUM('Fact_OrderItem'[total_order_value])
		formatString: #,0
		lineageTag: cfcedd6c-699c-5f9e-9dfb-bf7257f0ef9b

	measure 'Product Revenue' = SUM('Fact_OrderItem'[price])
		formatString: #,0
		lineageTag: 43e5c9a7-2679-5c49-8bda-42ae8221d7e2

	measure 'Freight Cost' = SUM('Fact_OrderItem'[freight_value])
		formatString: #,0
		lineageTag: 0cf3e9a7-db96-5761-b376-cb0594fc897c

	measure 'Freight % of Revenue' = DIVIDE([Freight Cost], [Revenue])
		formatString: 0.0%
		lineageTag: f7f705e7-1136-589a-be22-a4fc869399c1

	measure 'Items Sold' = COUNTROWS('Fact_OrderItem')
		formatString: #,0
		lineageTag: 29af9372-ebb1-59de-926b-a8ba921025f9

	measure Sellers = DISTINCTCOUNT('Fact_OrderItem'[seller_id])
		formatString: #,0
		lineageTag: dae46289-2f4c-53d3-907e-3eabc3a52e3c

	measure 'Avg Order Value' = DIVIDE([Revenue], [Orders])
		formatString: #,0.00
		lineageTag: 8ceb986c-748e-5cac-9338-2618717c46d6

	measure 'Avg Items per Order' = DIVIDE([Items Sold], [Orders])
		formatString: 0.00
		lineageTag: 1c63f1d5-ba2b-5767-9c1e-18a604368513

